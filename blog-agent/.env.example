SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Dashboard authentication (REQUIRED in production) ───────────────────────
# Without both of these the dashboard fails CLOSED in production (every route
# 401s) and runs UNPROTECTED in development with a loud warning. There is no
# configuration that leaves production open.
# APP_SECRET signs the session cookie — use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
DASHBOARD_PASSWORD=

# ── Spend ceilings ──────────────────────────────────────────────────────────
# Hard stops, checked before each agent call. 0 disables a ceiling entirely
# (not recommended — an unbounded pipeline is an unbounded bill).
MAX_RUN_COST_USD=3.00
MAX_DAILY_COST_USD=25.00
# Per-agent event recording powering /swarm. Set false to disable.
SWARM_TELEMETRY=true
# Optional: override the built-in price table without a deploy, e.g.
#   LLM_PRICE_OVERRIDES={"openai/gpt-4o": [2.5, 10.0]}
LLM_PRICE_OVERRIDES=

# ── View-data privacy (DPDP Act / GDPR) ─────────────────────────────────────
# Salt for pseudonymising visitor session ids. If unset, session ids are
# DROPPED rather than stored as weak hashes. Rotating it deliberately breaks
# pseudonym continuity — that is correct behaviour, not a bug.
VIEW_HASH_SALT=
# Days to retain a view row before the purge job deletes it (max 400).
VIEW_RETENTION_DAYS=90

# ── LLM provider ───────────────────────────────────────────────────────────
# openai (default) drives the whole swarm via ADK's LiteLlm wrapper.
# Set to "gemini" to fall back to the old Google path (vars below).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# gpt-4o cannot write long-form: measured 2026-08-02 over 4 runs it stopped at
# 634-764 words against the 1,100-word floor and failed the gate every time. This
# is the model settling, not truncation — OPENAI_MAX_TOKENS was 4096 throughout.
# Bake-off on the real writer prompt, n=3 each (floor 1,100, GEO gate must pass):
#   gpt-4o        680 words          GEO fail   — fails both gates
#   gpt-4.1       1069-1322 words    GEO 2/3    — straddles the floor, 2/3 cleared
#   gpt-5.4-mini  1694 words         GEO fail   — misses the competitor table
#   gpt-5.4       2135-2309 words    GEO 3/3    — clears both, sections at 274-347
OPENAI_MODEL=gpt-5.4
# Max output tokens per agent call. Must stay high enough for a 1,400-2,000 word
# post (~2,700 tokens) or the writer silently truncates and the length gate rejects.
# 8192 rather than 4096 because gpt-5.4 bills reasoning tokens against this budget
# — a 2,309-word draft measured 2,923 output tokens on its own.
#
# This var is a misnomer and is kept only because it is already set in production:
# with per-role routing the cap applies to whichever provider the role resolved to,
# OpenAI or not. Prefer LLM_MAX_TOKENS / LLM_MAX_TOKENS_<ROLE> below.
OPENAI_MAX_TOKENS=8192

# Provider-neutral caps. LLM_MAX_TOKENS_<ROLE> beats LLM_MAX_TOKENS beats
# OPENAI_MAX_TOKENS beats the per-role defaults in swarm/llm.py (writer 8192;
# schema/social/linker 2048; imager 1024; ideator 4096).
#
# Why per-role: on a prepaid provider the cap is not free headroom, it is the size
# of the reservation the balance is checked against. OpenRouter refused eight
# writer calls on 2026-08-27 with "You requested up to 8192 tokens, but can only
# afford 2074" — a schema call that will only ever emit 400 tokens has no business
# reserving 8192 of them and failing the same check.
LLM_MAX_TOKENS=
# LLM_MAX_TOKENS_WRITER=8192
# LLM_MAX_TOKENS_SCHEMA=2048

# ── Per-role model routing (optional) ───────────────────────────────────────
# Leave every LLM_MODEL_* var blank and the swarm behaves exactly as above: one
# model for all ten roles, chosen by LLM_PROVIDER/OPENAI_MODEL. Set them to put
# each role on the model that suits its job — the writer needs to clear the
# 1,100-word floor and the GEO gate, the schema and linker roles are doing
# structured transforms and do not.
#
# A spec is "<provider>/<model>", provider ∈ openai | openrouter | gemini:
#   openai/gpt-5.4                      → OpenAI direct, needs OPENAI_API_KEY
#   openrouter/anthropic/claude-haiku-4.5 → via OpenRouter, needs OPENROUTER_API_KEY
# A bare name ("gpt-5.4") is read as openai/. Roles can sit on different
# providers in the same run.
#
# Roles: research audit writer humaniser publisher linker schema social imager ideator
# LLM_MODEL_DEFAULT covers every role without its own override.
#
# One wallet across every vendor, at the cost of a top-up fee and a third party in
# the request path. Rates below read from openrouter.ai/api/v1/models 2026-08-11,
# USD per 1M tokens (in/out):
#   openai/gpt-5.4                        2.50 / 15.00   proven on both gates
#   anthropic/claude-sonnet-4.6           3.00 / 15.00   untested here
#   anthropic/claude-haiku-4.5            1.00 /  5.00   3x cheaper out
#   google/gemini-2.5-flash               0.30 /  2.50   6x cheaper out
#   deepseek/deepseek-chat-v3.1           0.25 /  0.95  16x cheaper out
OPENROUTER_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_WRITER=
LLM_MODEL_HUMANISER=
LLM_MODEL_RESEARCH=
LLM_MODEL_AUDIT=
LLM_MODEL_PUBLISHER=
LLM_MODEL_LINKER=
LLM_MODEL_SCHEMA=
LLM_MODEL_SOCIAL=
LLM_MODEL_IMAGER=
LLM_MODEL_IDEATOR=

# ── Provider fallback (optional, OFF by default) ────────────────────────────
# Comma-separated second-choice specs, same form as LLM_MODEL_*. Passed straight
# to LiteLLM's own `fallbacks` argument, so failover happens inside the client
# swarm/llm.py already builds — there is no second code path.
#
#   LLM_FALLBACK_SCHEMA=gemini/gemini-2.5-flash
#
# Off by default, deliberately. A fallback is right for a provider outage and
# wrong for a quality-critical role: the bake-off above shows gpt-4o could not
# clear the length gate at all, so quietly demoting the writer buys a draft that
# fails a gate and costs a second call. Set it for the mechanical roles first, and
# for the writer only against a model you have actually run the gates against.
#
# A fallback also cannot rescue an empty wallet on a shared provider: every
# openrouter/* spec draws on the same balance. Point the fallback at a different
# provider (gemini/, openai/) or it will fail for the same reason the primary did.
LLM_FALLBACK_DEFAULT=
# LLM_FALLBACK_WRITER=

# ── Image generation (OFF by default) ───────────────────────────────────────
# Flip ENABLE_IMAGES=true to generate hero/inline images via OpenAI.
# dall-e-3 needs no org verification; gpt-image-1 requires a verified org.
ENABLE_IMAGES=false
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VISION_MODEL=gpt-4o

# ── Gemini fallback (only used when LLM_PROVIDER=gemini) ─────────────────────
ADK_GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

TAVILY_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

SITE_API_URL=https://www.buteforce.com/api/agent/blog
AGENT_SECRET_KEY=
PUBLISH_DRY_RUN=true
BUTEFORCE_KNOWLEDGE_ROOT=

# ── Autopilot (autonomous scheduler) ─────────────────────────────
# The first four are BREAK-GLASS OVERRIDES. They are normally left unset: the
# switches live in the `autopilot_settings` row and are thrown from the dashboard,
# because the Python worker is a new process on every tick and could read an env
# var but never have one changed under it. Setting one here takes the switch away
# from the dashboard entirely -- the UI then says the host is overriding it rather
# than showing a control that does nothing. Use that when you need to force the
# engine off, or force human review back on, from the server itself.
#
# Kill switch -- does the engine run at all.
# AUTOPILOT_ENABLED=true
# Does the engine stop at the research and draft gates for a person.
# false = topics research, write, schedule and publish with nobody reading them.
# HUMAN_IN_THE_LOOP=false
# Cadence: hours between published posts (the rhythm Google sees). This is NOT the
# review window and does not change when human review is switched off -- that is
# what stops an unattended engine dumping a backlog in one afternoon.
# PUBLISH_GAP_HOURS=24
# The human's reprieve: hours a finished post waits before it may publish.
# Applies only while human review is on; collapses to 0 when it is off.
# VETO_WINDOW_HOURS=24

# Finished posts to keep scheduled ahead.
AUTOPILOT_BUFFER=1
# Topics the ideator generates when the roadmap queue empties.
AUTOPILOT_IDEATE_BATCH=8
# Max research+write work per tick (keeps each tick bounded in runtime).
AUTOPILOT_MAX_PRODUCE_PER_TICK=1
# Shared secret for /api/autopilot/tick — must match the GitHub Actions repo secret.
AUTOPILOT_TICK_SECRET=

# ── ANALYTICS (feedback loop) ───────────────────────────────────
# Read with the same GCP service account as Vertex (GOOGLE_APPLICATION_CREDENTIALS).
# Grant it: Search Console -> Users and permissions -> Restricted
#           GA4 -> Admin -> Property access management -> Viewer
# Verify with: python run.py --check-analytics
#
# Search Console property identifier. Two shapes, NOT interchangeable:
#   Domain property     -> sc-domain:example.com
#   URL-prefix property -> https://www.example.com/   (trailing slash matters)
GSC_SITE_URL=sc-domain:example.com
# Numeric GA4 property ID (Admin -> Property details), NOT the G-XXXXXXX measurement ID.
GA4_PROPERTY_ID=
# Trailing window re-pulled each run; GSC revises the most recent 2-3 days.
ANALYTICS_INGEST_DAYS=7

# ── LEARNING (scoring + bandit) ─────────────────────────────────
# All optional; defaults live in swarm/learning/config.py and are recorded on
# every run in learning_snapshots.config so any score can be reproduced.
# LEARN_MIN_AGE_DAYS=14          posts younger than this are not judged
# LEARN_SUCCESS_IMPRESSIONS=50   impressions that count as a successful post
# LEARN_MIN_POSTS_TO_ACT=25      matured posts before the bandit may steer
# LEARN_BANDIT_ACTIVE=false      master switch; false = shadow mode
