# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. Anything listed here is never sent to the daemon.

.git
.gitignore

# Never bake credentials into an image.
**/.env
**/.env.*
!**/.env.example

# Rebuilt inside the image; copying the host's copies would import Windows
# binaries into a Linux container.
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
blog-agent/dashboard/.next
blog-agent/dashboard/out
blog-agent/dashboard/tsconfig.tsbuildinfo

# Local scratch and captures that have no business in a production image.
.planning
.playwright-mcp
designs
zDocuments
*.log
out.txt
zlog.txt
**/*.png
!blog-agent/dashboard/public/**
